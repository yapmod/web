{
  "manifest_version": 2,
  "name": "Yapmod Web",
  "version": "1.3.0",
  "description": "Automatically injects the Yapmod client bundle into Yapin",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.yapin.gg/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "*://*.yapin.gg/*",
    "https://api.github.com/",
    "https://raw.githubusercontent.com/",
    "https://github.com/",
    "https://release-assets.githubusercontent.com/"
  ]
}
