{
  "manifest_version": 3,
  "name": "Yapmod Web",
  "version": "1.1.1",
  "description": "Automatically injects the Yapmod client bundle into Yapin",
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.yapin.gg/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.github.com/",
    "https://raw.githubusercontent.com/",
    "https://github.com/",
    "https://release-assets.githubusercontent.com/"
  ]
}
