{
  "name": "@yapmod/web",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && node scripts/embed-plugin-source.mjs && cp src/chrome/manifest.json dist/chrome/ && cp src/firefox/manifest.json dist/firefox/",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt src/ --check",
    "release": "changelogen --bump --no-commit --no-tag",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.29.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.0.0",
    "@typescript/typescript6": "^6.0.0",
    "@yapmod/builder": "^1.2.1",
    "@yapmod/types": "^1.0.2",
    "babel-preset-solid": "^1.8.4",
    "changelogen": "^0.6.2",
    "oxfmt": "^0.25.0",
    "oxlint": "^1.16.0",
    "solid-js": "^1.9.18",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2"
  }
}
